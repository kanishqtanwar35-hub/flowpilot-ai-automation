# ---------------------------------------------------------------------------
# FlowPilot configuration. Copy to `.env` and fill in what you have.
# EVERY value is optional — with an empty .env the app runs end-to-end in
# SIMULATED mode (heuristic AI + simulated integrations) so it can be demoed
# offline. Add keys to switch each layer to live.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=5000
FLASK_DEBUG=0
DATABASE_PATH=flowpilot.db

# --- Inbound webhook security ----------------------------------------------
# HMAC-SHA256 shared secret. If unset, signature verification is SKIPPED and
# every run is flagged `unverified` in the dashboard.
WEBHOOK_SECRET=change-me-to-a-long-random-string
WEBHOOK_MAX_SKEW_SECONDS=300

# --- Claude (AI extraction + reply drafting) --------------------------------
# Unset -> the deterministic heuristic engine is used instead (no network).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=low
AI_MAX_TOKENS=4000

# --- Third-party REST integrations ------------------------------------------
# CRM: any REST endpoint accepting POST {contact}. Leave blank to simulate.
# `scripts/mock_crm_server.py` gives you a real one on http://127.0.0.1:5055
CRM_BASE_URL=
CRM_API_KEY=

# Notification webhook (Slack / Discord / Teams / any HTTPS endpoint).
NOTIFY_WEBHOOK_URL=

# Outbound webhook fan-out (your own systems). Signed with OUTBOUND_SECRET.
OUTBOUND_WEBHOOK_URL=
OUTBOUND_SECRET=

# Company enrichment REST API (GET ?domain=acme.com). Blank -> local heuristic.
ENRICHMENT_URL=

HTTP_TIMEOUT_SECONDS=8
HTTP_MAX_RETRIES=2
